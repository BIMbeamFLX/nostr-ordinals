# NORD prototype configuration - copy to .env and fill in.

# apex for the three vhosts: mint.<DOMAIN>, relay.<DOMAIN>, blossom.<DOMAIN>
# (three A/AAAA records pointing at this box, set before first boot so
# caddy can provision certificates)
DOMAIN=example.com

# ---- mint (see lnurl-mint's .env.example for the full list) ----
BASE_URL=https://mint.example.com
USERNAME=mint
TITLE=600B mint
DESCRIPTION=NORD prototype - pay to mint a bearer note.
VERIFY_ENABLED=true

# tight limits while the code is young: 21k sats ceiling per note, and
# remember melts pay routing fees out of the mint's pocket
MIN_SENDABLE_MSAT=1000
MAX_SENDABLE_MSAT=21000000

# ---- NORD asset layer ----
# a dedicated nostr key (32 bytes hex): openssl rand -hex 32
NOSTR_SECRET_KEY=
# our own relay first (it's the hint embedded in asset pointers), public
# relays after for reach
NOSTR_RELAYS=wss://relay.example.com,wss://relay.damus.io
